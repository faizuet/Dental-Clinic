APP_NAME=Nabi Dental Clinic API
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Railway/Render will usually inject DATABASE_URL. If you set it yourself, either
# postgres:// or postgresql:// is fine — the app converts it to asyncpg.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/nabi_dental

# Generate a long random value. Do not reuse the development secret.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=30

DEFAULT_CLINIC_NAME=Nabi Dental Clinic
DEFAULT_CURRENCY=PKR
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_HOME_BUDGET=30000.00

# Change these before anyone else logs in.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeMeNow!1
OWNER_FULL_NAME=Clinic Owner

UPLOAD_DIR=uploads
