APP_NAME=Nabi Dental Clinic API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database password for this computer. Compose reads these values and does not keep them in the compose file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=nabi_dental

# Used when running the API on the host. Docker Compose points the app container at the db service.
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-long-random-password@localhost:5433/nabi_dental

# Placeholder only. The API replaces this with a unique key in .env on first start.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=
# Empty is fine on a laptop: localhost / 127.0.0.1 on any port is allowed.

DEFAULT_CLINIC_NAME=Nabi Dental Clinic
DEFAULT_CURRENCY=PKR
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_HOME_BUDGET=30000.00

OWNER_EMAIL=nabidentalclinic@gmail.com
OWNER_PASSWORD=ChangeMeNow!1
OWNER_FULL_NAME=Clinic Owner

MAX_FUTURE_DAYS=30
MAX_RANGE_YEARS=10

UPLOAD_DIR=uploads
# Automatic backups are written outside the database volume.
# The desktop shortcut sets NABI_BACKUP_DIR to this computer's user folder.
BACKUP_RETENTION_COUNT=14
BACKUP_INTERVAL_HOURS=24
AVATAR_MAX_BYTES=2000000
