APP_NAME=Nabi Dental Clinic API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nabi_dental

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=
# Empty is fine in development: localhost / 127.0.0.1 on any port is allowed.

DEFAULT_CLINIC_NAME=Nabi Dental Clinic
DEFAULT_CURRENCY=PKR
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_HOME_BUDGET=30000.00

OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeMeNow!1
OWNER_FULL_NAME=Clinic Owner

MAX_FUTURE_DAYS=30
MAX_RANGE_YEARS=10

FORWARDED_ALLOW_IPS=
UPLOAD_DIR=uploads
AVATAR_MAX_BYTES=2000000

# Production: copy .env.production.example, set APP_ENV=production, and use a
# public DATABASE_URL plus a unique JWT_SECRET_KEY. Domain is optional.
